# MN GROUPS Backend Environment Variables
PORT=4000
NODE_ENV=development

# Database configuration
# Leave blank to use built-in local PGlite (PostgreSQL WASM with filesystem persistence)
# Or provide standard PostgreSQL connection URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mn_groups

# Firebase Cloud Messaging (FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloud Object Storage (S3 / Azure Blob)
# Leave blank for built-in local upload server
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
